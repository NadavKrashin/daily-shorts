# Copy to .env and fill in. NEVER commit .env. In production prefer a secret manager
# (Docker secrets, Doppler, 1Password Connect, AWS/GCP secret managers) that injects these variables.

APP_ENV=development                 # production => dashboard refuses to start without a password
SECRET_KEY=change-me-to-a-long-random-string
DASHBOARD_USERNAME=ceo
DASHBOARD_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8000
POSTGRES_PASSWORD=waitwhy
# DATABASE_URL is set by docker-compose; for bare-metal use:
# DATABASE_URL=postgresql+psycopg://waitwhy:waitwhy@localhost:5432/waitwhy

# ---- Storage (local by default; S3-compatible recommended in production: R2 / B2 / S3)
STORAGE_LOCAL_ROOT=./data/media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- AI providers
ANTHROPIC_API_KEY=                  # research, fact-check, scripts, storyboards, QC review (console.anthropic.com)
ELEVENLABS_API_KEY=                 # brand voice - PAID plan required for commercial use
ELEVENLABS_VOICE_ID=                # a voice you are licensed to use commercially (no unauthorised clones)
HIGGSFIELD_API_KEY=                 # API key id from open.higgsfield.ai (separate wallet from the web app)
HIGGSFIELD_API_SECRET=
HEYGEN_API_KEY=                     # optional; not used by the default pipeline
PIPER_VOICE_PATH=                   # dev-only local voice (.onnx). NON-COMMERCIAL - QC blocks publishing with it

# ---- Platforms (official APIs only)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=              # scopes: youtube.upload, youtube.readonly, yt-analytics.readonly
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=             # long-lived Page token: pages_manage_posts, pages_read_engagement, pages_show_list
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=             # instagram_business_basic + instagram_business_content_publish (+ insights)
INSTAGRAM_GRAPH_HOST=graph.instagram.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_AUDITED=false            # only true after TikTok approves your Content Posting API audit

# ---- Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=                 # Slack/Discord-compatible incoming webhook
